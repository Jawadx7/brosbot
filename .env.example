# ── Server ────────────────────────────────────────────
SERVER_URL=http://localhost:3000
SERVER_PORT=3000

# ── Bot agent ─────────────────────────────────────────
BOT_NAME=CockBlockAI
BOT_MODEL_URL=http://localhost:11434     # Ollama default port

# ── Trigger settings ──────────────────────────────────
TRIGGER_SPONTANEOUS_PROB=0.20           # 20% chance to chime in per message
TRIGGER_KEYWORD_PROB=0.60               # 60% chance on keyword match
TRIGGER_INACTIVITY_SECONDS=180          # initiate after 3 min silence
BOT_COOLDOWN_MESSAGES=2                 # min human messages before bot speaks again
